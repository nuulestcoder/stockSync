# App configuration
APP_ENV=development
APP_PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=saas_stock

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cloudflare R2
STORAGE_MODE=local
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=saas-stock-assets
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=

# Asynq (background jobs)
ASYNQ_REDIS_URL=redis://localhost:6379
ASYNQ_CONCURRENCY=10

# Token encryption (32-byte hex key for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
